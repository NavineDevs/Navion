{
  "name": "navion",
  "version": "1.0.13",
  "description": "Zero-dependency web proxy engine with URL, HTML, CSS, and JS rewriting and built-in DNS-over-HTTPS resolution",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NavineDevs/Navion.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/server/index.js",
  "type": "module",
  "exports": {
    ".": "./src/server/index.js",
    "./server": "./src/server/create-server.js",
    "./app": "./src/server/create-app-server.js",
    "./proxy": "./src/server/proxy.js",
    "./config": "./src/server/config/navion.config.js",
    "./rewriters/url": "./src/server/rewriters/url.js",
    "./rewriters/html": "./src/server/rewriters/html.js",
    "./rewriters/css": "./src/server/rewriters/css.js",
    "./rewriters/js": "./src/server/rewriters/js.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "navion-core": "server.js"
  },
  "files": [
    "server.js",
    "src",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check src/server/index.js && node --check src/server/create-app-server.js && node --check src/proxy.js && node --check src/internal/doh-resolver.js",
    "test": "node --test"
  },
  "keywords": [
    "proxy",
    "web-proxy",
    "navion",
    "proxy-core",
    "proxy-engine",
    "zero-dependencies"
  ],
  "author": "Navine",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}
